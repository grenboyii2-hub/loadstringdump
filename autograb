local function isMyPlot(plot)
    local sign = plot and plot:FindFirstChild("PlotSign")
    local yourBase = sign and sign:FindFirstChild("YourBase")
    return yourBase and yourBase:IsA("BillboardGui") and yourBase.Enabled == true
end

local function getPromptPosition(prompt)
    local att = prompt and prompt.Parent
    local spawn = att and att.Parent
    return spawn and spawn:IsA("BasePart") and spawn.Position or nil
end

local function distanceToPrompt(prompt)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local pos = getPromptPosition(prompt)
    if not root or not pos then return math.huge end
    return (root.Position - pos).Magnitude
end

local function findNearestPrompt()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end

    local nearest, minDist = nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
        if not isMyPlot(plot) then
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if podiums then
                for _, podium in ipairs(podiums:GetChildren()) do
                    local base = podium:FindFirstChild("Base")
                    local spawn = base and base:FindFirstChild("Spawn")
                    if spawn then
                        local dist = (spawn.Position - root.Position).Magnitude
                        if dist <= CONFIG.radius and dist < minDist then
                            local att = spawn:FindFirstChild("PromptAttachment")
                            if att then
                                for _, p in ipairs(att:GetChildren()) do
                                    if p:IsA("ProximityPrompt") and p.Enabled and p.ActionText and p.ActionText:find("Steal") then
                                        nearest = p
                                        minDist = dist
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nearest
end

local setProgressBarValue, resetProgressBar, settleProgressBar

local function cachePromptCallbacks(prompt)
    if promptCache[prompt] then return end
    local data = { hold = {}, trigger = {}, ready = true }
    if type(getconnections) == "function" then
        local ok, conns = pcall(getconnections, prompt.PromptButtonHoldBegan)
        if ok and conns then
            for _, c in ipairs(conns) do
                if c.Function then table.insert(data.hold, c.Function) end
            end
        end
        local ok2, conns2 = pcall(getconnections, prompt.Triggered)
        if ok2 and conns2 then
            for _, c in ipairs(conns2) do
                if c.Function then table.insert(data.trigger, c.Function) end
            end
        end
    end
    promptCache[prompt] = data
end

local function executeSteal(prompt)
    if isStealing then return end
    if not prompt or not prompt.Parent then return end
    cachePromptCallbacks(prompt)
    local data = promptCache[prompt]
    if not data or not data.ready then return end
    if #data.hold == 0 and #data.trigger == 0 then
        warn("[AutoSteal] no prompt connections — executor lacks getconnections?")
        return
    end

    data.ready = false
    isStealing = true

    task.spawn(function()
        for _, fn in ipairs(data.hold) do task.spawn(fn) end
        local holdTime = CONFIG.duration * CONFIG.holdRatio
        setProgressBarValue(CONFIG.holdRatio, holdTime)

        local startTime = tick()
        local cancelled = false
        while isStealing and prompt.Parent do
            if distanceToPrompt(prompt) > CONFIG.radius then cancelled = true break end
            if tick() - startTime >= holdTime then break end
            task.wait()
        end

        if not cancelled and isStealing and prompt.Parent then
            settleProgressBar(CONFIG.settleRatio or 0.99, 0.18)
        end

        if not cancelled and isStealing and prompt.Parent then
            local waitStart = tick()
            local inRange = false
            while isStealing and prompt.Parent and (tick() - waitStart) < 3 do
                local dist = distanceToPrompt(prompt)
                if dist > CONFIG.radius then cancelled = true break end
                if dist <= CONFIG.delayRadius then inRange = true break end
                task.wait()
            end

            if inRange and not cancelled and isStealing and prompt.Parent then
                local remaining = math.max(CONFIG.duration - holdTime, 0.05)
                setProgressBarValue(1, remaining)
                task.wait(remaining)
                if isStealing and prompt.Parent then
                    for _, fn in ipairs(data.trigger) do task.spawn(fn) end
                end
            end
        end

        resetProgressBar()
        task.wait(0.06)
        data.ready = true
        isStealing = false
    end)
end

local function autoStealLoop()
    if semiConn then semiConn:Disconnect() semiConn = nil end
    semiConn = RunService.Heartbeat:Connect(function()
        if not CONFIG.autoSteal then return end
        if isStealing then return end
        local prompt = findNearestPrompt()
        if prompt then executeSteal(prompt) end
    end)
end

local AutoSteal = {}
local uiUpdateCallback = nil

function AutoSteal.start()
    CONFIG.autoSteal = true
    autoStealLoop()
    if uiUpdateCallback then uiUpdateCallback() end
end

function AutoSteal.stop()
    CONFIG.autoSteal = false
    if semiConn then semiConn:Disconnect() semiConn = nil end
    isStealing = false
    if uiUpdateCallback then uiUpdateCallback() end
end

function AutoSteal.toggle()
    if CONFIG.autoSteal then AutoSteal.stop() else AutoSteal.start() end
end

local function getContainer()
    if gethui then
        local ok, res = pcall(gethui)
        if ok and res then return res end
    end
    return CoreGui or player:WaitForChild("PlayerGui")
end

