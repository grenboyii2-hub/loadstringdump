setProgressBarValue = function(ratio, timeSec)
    if progressConnection then progressConnection:Disconnect() progressConnection = nil end
    PercentText.TextColor3 = Color3.fromRGB(255, 255, 255)
    local target = math.clamp(ratio, 0, 1)
    local start = Bar.Size.X.Scale
    local t0 = tick()
    local dur = math.max(timeSec or 0.2, 0.01)
    progressConnection = RunService.RenderStepped:Connect(function()
        local a = math.clamp((tick() - t0) / dur, 0, 1)
        local r = start + (target - start) * a
        Bar.Size = UDim2.new(r, 0, 1, 0)
        PercentText.Text = math.floor(r * 100 + 0.5) .. "%"
        if a >= 1 then
            if progressConnection then progressConnection:Disconnect() progressConnection = nil end
        end
    end)
end

-- soft drop 90% → settleRatio (default 70%), not all the way to 0/50
settleProgressBar = function(ratio, timeSec)
    setProgressBarValue(math.clamp(ratio or 0.70, 0, 1), timeSec or 0.18)
end

resetProgressBar = function()
    if progressConnection then progressConnection:Disconnect() progressConnection = nil end
    PercentText.Text = "100%"
    TweenService:Create(Bar, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 0, 1, 0)
    }):Play()
    task.delay(0.6, function()
        if not isStealing then
            PercentText.Text = "0%"
            PercentText.TextColor3 = Color3.fromRGB(160, 160, 160)
        end
    end)
end

local fc = 0
local lc = tick()
RunService.RenderStepped:Connect(function()
    fc = fc + 1
    local now = tick()
    if now - lc >= 0.5 then
        local fps = math.floor(fc / (now - lc))
        local ping = 0
        pcall(function()
            ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        StatsText.Text = string.format("FPS: %d  |  PING: %dms", fps, ping)
        fc = 0
        lc = now
    end
end)

